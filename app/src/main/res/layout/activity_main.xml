<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screen OCR"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Grab English and اردو text from any app, with a floating button."
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stopped"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggleBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Start floating button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Recognition language"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/langGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/langBoth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="English + اردو (mixed pages)" />

            <RadioButton
                android:id="@+id/langEng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="English only (most accurate for English)" />

            <RadioButton
                android:id="@+id/langUrd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اردو only (most accurate for Urdu)" />
        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoCopySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Copy text to clipboard automatically" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pickImageBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Extract text from an image file" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="3dp"
            android:text="How to use\n1. Tap “Start floating button” and allow the permissions.\n2. On the screen-sharing prompt choose “Entire screen” and tap Start now.\n3. Open any app. Tap the floating OCR bubble, then choose Full screen or Select area.\n4. The text opens in an editable window: edit it, then tap Copy.\n\nTip: drag the bubble anywhere. Tap Stop in the menu (or the notification) to remove it."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
